#!/data/data/com.termux/files/usr/bin/bash
# texoff - stop Vortexa Studio
ROOT=/data/data/com.termux/files/home/VortexA
echo "Stopping Vortexa Studio..."
cd "$ROOT" 2>/dev/null || true
if [ -f "$ROOT/vortexa_ws.pid" ]; then
  kill "$(cat "$ROOT/vortexa_ws.pid")" 2>/dev/null || true
  rm -f "$ROOT/vortexa_ws.pid"
fi
if [ -f "$ROOT/vortexa_http.pid" ]; then
  kill "$(cat "$ROOT/vortexa_http.pid")" 2>/dev/null || true
  rm -f "$ROOT/vortexa_http.pid"
fi
pkill -f "python3 server.py" 2>/dev/null || true
pkill -f "http.server 8080" 2>/dev/null || true
echo "Vortexa Studio stopped"

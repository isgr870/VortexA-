#usda 1.0
(
    defaultPrim = "Robot"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "Vortexa Studio v3 sim-ready USD — open in Isaac Sim / Omniverse"
)

def Xform "Robot" (
    kind = "component"
)
{
    def Xform "base_link"
    {
    def Xform "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    ) {
        float3 xformOp:translate = (0, 0, 0.00000)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 2.0000
        def Cube "visual" {
            float size = 0.1600
            float3 xformOp:scale = (1, 1, 0.6250)
            float3 xformOp:translate = (0, 0, 0.05000)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        ) {
            float size = 0.1600
            float3 xformOp:scale = (1, 1, 0.6250)
            float3 xformOp:translate = (0, 0, 0.05000)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
    }
}


